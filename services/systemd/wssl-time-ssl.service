[Unit]
Description=WSSL time SSL service
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/wssl
EnvironmentFile=/etc/default/wssl-examples
ExecStart=/opt/wssl/examples/time_ssl.e ${WSSL_CERT} ${WSSL_KEY}
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
