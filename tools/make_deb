#!/bin/sh
# Assemble the wssl-examples .deb from an already built tree.
# Needs only dpkg-deb (fakeroot is used when available).
# No debhelper required.

BASE_DIR=$(dirname $(dirname $(readlink -f ${0})))
VERSION=$(cat ${BASE_DIR}/VERSION)
ARCH=$(dpkg --print-architecture)
PKG_NAME="wssl-examples"
STAGE="${BASE_DIR}/out/deb-root"
DEB="${BASE_DIR}/out/${PKG_NAME}_${VERSION}_${ARCH}.deb"

if [ ! -f ${BASE_DIR}/out/libwssl.a ]
then
  echo "build the tree first (make)" >&2
  exit 1
fi

rm -r -f ${STAGE}
mkdir -p ${STAGE}/DEBIAN ${STAGE}/usr/bin ${STAGE}/lib/systemd/system ${STAGE}/etc/default ${STAGE}/etc/letsencrypt/renewal-hooks/deploy

for example in echo time chat
do
  cp ${BASE_DIR}/examples/${example}.e ${STAGE}/usr/bin/wssl-${example}
  cp ${BASE_DIR}/examples/${example}_ssl.e ${STAGE}/usr/bin/wssl-${example}-ssl
done
chmod 0755 ${STAGE}/usr/bin/*

for service in echo time chat echo-ssl time-ssl chat-ssl
do
  sed -e 's|/opt/wssl/examples/\([a-z][a-z_]*\)\.e|/usr/bin/wssl-\1|' -e 's|wssl-\([a-z]*\)_ssl|wssl-\1-ssl|' \
    ${BASE_DIR}/services/systemd/wssl-${service}.service > ${STAGE}/lib/systemd/system/wssl-${service}.service
done

cp ${BASE_DIR}/services/default/wssl-examples ${STAGE}/etc/default/wssl-examples
chmod 0644 ${STAGE}/etc/default/wssl-examples
cp ${BASE_DIR}/services/letsencrypt/wssl-ssl-examples ${STAGE}/etc/letsencrypt/renewal-hooks/deploy/wssl-ssl-examples
chmod 0755 ${STAGE}/etc/letsencrypt/renewal-hooks/deploy/wssl-ssl-examples

cat > ${STAGE}/DEBIAN/control <<EOF
Package: ${PKG_NAME}
Version: ${VERSION}
Section: net
Priority: optional
Architecture: ${ARCH}
Depends: libssl3t64 | libssl3
Recommends: certbot
Maintainer: chupcko <https://github.com/chupcko/wssl>
Description: wssl websocket example servers, plain and OpenSSL
 Example echo, time and chat servers from the wssl project,
 each as a plain and an OpenSSL (TLS) variant, with systemd
 units, default certificate configuration and a certbot
 deploy hook.
EOF

echo "/etc/default/wssl-examples" > ${STAGE}/DEBIAN/conffiles

cat > ${STAGE}/DEBIAN/postinst <<'EOF'
#!/bin/sh
set -e
systemctl daemon-reload
for service in echo time chat echo-ssl time-ssl chat-ssl
do
  systemctl enable --now wssl-${service} || true
done
EOF

cat > ${STAGE}/DEBIAN/prerm <<'EOF'
#!/bin/sh
set -e
for service in echo time chat echo-ssl time-ssl chat-ssl
do
  systemctl disable --now wssl-${service} || true
done
EOF

cat > ${STAGE}/DEBIAN/postrm <<'EOF'
#!/bin/sh
set -e
systemctl daemon-reload || true
EOF
chmod 0755 ${STAGE}/DEBIAN/postinst ${STAGE}/DEBIAN/prerm ${STAGE}/DEBIAN/postrm

if command -v fakeroot >/dev/null 2>&1
then
  fakeroot dpkg-deb -b ${STAGE} ${DEB}
else
  dpkg-deb -b ${STAGE} ${DEB}
fi
