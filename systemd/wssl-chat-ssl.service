[Unit]
Description=WSSL chat SSL service
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/root/wssl
ExecStart=/root/wssl/examples/chat.e /etc/letsencrypt/live/beta.chupcko.org/fullchain.pem /etc/letsencrypt/live/beta.chupcko.org/privkey.pem
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
